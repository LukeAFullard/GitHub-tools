# Cloudflare Pages response headers (also applied by Netlify). The pages carry the same CSP in a
# <meta> tag; these add what a <meta> tag cannot set: frame-ancestors, nosniff and caching.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://api.deps.dev; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
